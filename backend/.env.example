APP_NAME=结构健康监测平台
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5432/resistance_db
# 前端开发服务器端口，与 frontend/vite.config.js 里的 server.port 一致
CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_STRING_LONGER_THAN_32_BYTES
MAX_RECEIVED_ROWS=200000
